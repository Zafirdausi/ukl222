{
  "build": {
    "steps": [
      {
        "name": "install",
        "commands": ["npm install"]
      },
      {
        "name": "build", 
        "commands": ["npm run build"],
        "dependsOn": ["install"]
      }
    ]
  },
  "deploy": {
    "startCommand": "npx prisma db push && node dist/main.js"
  }
}